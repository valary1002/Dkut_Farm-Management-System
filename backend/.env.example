PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Production may contain comma-separated frontend origins.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# MongoDB Atlas: mongodb+srv://<username>:<url-encoded-password>@<cluster>.mongodb.net/
# Add this machine's IP address to Atlas Network Access before starting the API.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB=dkut_farm
MONGODB_TRANSACTIONS=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FULL_NAME=System Admin
SEED_ADMIN_PHONE=+254700000000
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-host.example.com/api/payments/mpesa/callback
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
ORDER_PAYMENT_TIMEOUT_HOURS=24
ORDER_AUTO_DELIVER_DAYS=3
ORDER_MAINTENANCE_SECRET=replace-with-a-random-maintenance-secret
